---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import PaginatedPostList from "../../../../components/PaginatedPostList.astro";
import {
  getResolvedPostsByTagSlug,
  getResolvedTags,
  getTagHref,
} from "../../../../lib/content";
import { getPaginatedPageNumbers } from "../../../../lib/pagination";

export async function getStaticPaths() {
  const tags = await getResolvedTags();
  const paths = [];

  for (const tag of tags) {
    const posts = await getResolvedPostsByTagSlug(tag.slug);

    for (const page of getPaginatedPageNumbers(posts.length)) {
      paths.push({
        params: { slug: tag.slug, page: String(page) },
        props: { page, posts, tag },
      });
    }
  }

  return paths;
}

const { page, posts, tag } = Astro.props;
const resultLabel = posts.length === 1 ? "1 post" : `${posts.length} posts`;
const description = tag.description || `${resultLabel} filed under this tag.`;
---

<BaseLayout title={`Tag: ${tag.label} - Page ${page} - Built by Underdogs`}>
  <main class="main">
    <PageHeader
      title={`Tag: ${tag.label}`}
      description={description}
      image={tag.headerImage}
    />

    <PaginatedPostList
      posts={posts}
      basePath={getTagHref(tag.slug)}
      currentPage={page}
    />
  </main>
</BaseLayout>
