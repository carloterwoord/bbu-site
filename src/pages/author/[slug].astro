---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import BackButton from "../../components/BackButton.astro";
import PaginatedPostList from "../../components/PaginatedPostList.astro";
import {
  getAuthorHref,
  getAuthors,
  getPageHref,
  getResolvedPostsByAuthorSlug,
} from "../../lib/content";

export async function getStaticPaths() {
  const authors = await getAuthors();
  return authors.map((author) => ({
    params: { slug: author.data.slug },
    props: { author },
  }));
}

const { author } = Astro.props;
const posts = await getResolvedPostsByAuthorSlug(author.data.slug);
---

<BaseLayout title={`${author.data.name} - Built by Underdogs`}>
  <main class="main">
    <BackButton href={getPageHref("search")} />
    <div class="page">
      <AuthorCard
        name={author.data.name}
        bio={author.data.bio}
        avatar={author.data.avatar}
        avatarAlt={author.data.avatarAlt}
        links={author.data.socialLinks}
      />
    </div>

    <hr class="page__divider" />

    <PaginatedPostList
      posts={posts}
      basePath={getAuthorHref(author.data.slug)}
    />
  </main>
</BaseLayout>
