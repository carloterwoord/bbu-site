---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchForm from "../components/SearchForm.astro";
import {
  formatDate,
  getArchiveMonthHref,
  getCategoryHref,
  getPostHref,
  getResolvedPosts,
  getTaxonomySlug,
} from "../lib/content";
import { getProgressiveImagePlaceholder } from "../lib/images";
import { getPostPreviewHtml } from "../lib/preview";

const posts = await getResolvedPosts();
const RESULTS_PER_PAGE = 6;

function textFromHtml(value: string) {
  return value
    .replace(/<script[\s\S]*?<\/script>/gi, " ")
    .replace(/<style[\s\S]*?<\/style>/gi, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, " ")
    .trim();
}

function textFromMarkdown(value: string) {
  return textFromHtml(value)
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#*_>~-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

const resultItems = await Promise.all(
  posts.map(async (post) => {
    const firstCategory = post.categories[0];
    const categoryLabel = firstCategory?.data.name ?? "Category";
    const categoryHref = getCategoryHref(firstCategory?.data.slug ?? "category");
    const year = post.entry.data.date.getFullYear();
    const month = post.entry.data.date.getMonth() + 1;
    const excerptText = textFromHtml(post.entry.data.excerpt);
    const bodyText = textFromMarkdown(post.entry.body ?? "");
    const previewHtml = getPostPreviewHtml(
      post.entry.body,
      post.entry.data.excerpt,
      1
    );
    const tagSlugs = post.entry.data.tags.map(getTaxonomySlug);
    const searchText = [
      post.entry.data.title,
      excerptText,
      bodyText,
      post.entry.data.tags.join(" "),
      categoryLabel,
      post.author?.data.name ?? "",
    ].join(" ");

    return {
      title: post.entry.data.title,
      href: getPostHref(post.entry.data.slug),
      coverImage: post.entry.data.coverImage,
      coverImagePlaceholder: await getProgressiveImagePlaceholder(
        post.entry.data.coverImage
      ),
      coverImageAlt: post.entry.data.coverImageAlt,
      dateISO: post.entry.data.date.toISOString().slice(0, 10),
      dateLabel: formatDate(post.entry.data.date),
      dateHref: getArchiveMonthHref(year, month),
      categoryLabel,
      categoryHref,
      authorSlug: post.author?.data.slug ?? "",
      year: String(year),
      month: `${year}-${String(month).padStart(2, "0")}`,
      tagSlugs: tagSlugs.join(" "),
      searchText,
      previewHtml,
    };
  })
);

const resultItemsJson = JSON.stringify(resultItems)
  .replace(/</g, "\\u003c")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
---

<BaseLayout title="Results - Built by Underdogs">
  <main class="main">
    <div class="page__header-wrapper">
      <div class="page__header">
        <header>
          <h1 data-results-title>Results</h1>
        </header>
        <article>
          <p data-results-summary>No posts found.</p>
        </article>
      </div>
    </div>

    <div class="page page__content page__content--search-results space-top--xl space-bottom--4xl">
      <SearchForm />

      <script
        is:inline
        type="application/json"
        data-search-results-data
        data-page-size={RESULTS_PER_PAGE}
        set:html={resultItemsJson}
      ></script>

      <p class="search__results-empty" data-search-empty>
        No posts matched this search.
      </p>

      <hr class="page__divider" data-results-pagination-divider hidden />
      <div class="page__pagination-wrapper" data-results-pagination hidden></div>
    </div>
  </main>

</BaseLayout>
