---
import BaseLayout from "../layouts/BaseLayout.astro";
import BackButton from "../components/BackButton.astro";
import PageHeader from "../components/PageHeader.astro";
import SearchForm from "../components/SearchForm.astro";
import {
  formatDate,
  getArchiveMonthHref,
  getCategoryHref,
  getPageHref,
  getPostHref,
  getResolvedPosts,
  getTaxonomySlug,
} from "../lib/content";
import {
  getPostCoverAlt,
  getPostCoverImage,
  getProgressiveImagePlaceholder,
} from "../lib/images";
import { getPostPreviewHtml } from "../lib/preview";

const posts = await getResolvedPosts();
const RESULTS_PER_PAGE = 6;

function textFromHtml(value: string) {
  return value
    .replace(/<script[\s\S]*?<\/script>/gi, " ")
    .replace(/<style[\s\S]*?<\/style>/gi, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, " ")
    .trim();
}

function textFromMarkdown(value: string) {
  return textFromHtml(value)
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#*_>~-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

const resultItems = await Promise.all(
  posts.map(async (post) => {
    const firstCategory = post.categories[0];
    const categoryLabel = firstCategory?.data.name ?? "Category";
    const categoryHref = getCategoryHref(firstCategory?.data.slug ?? "category");
    const year = post.entry.data.date.getFullYear();
    const month = post.entry.data.date.getMonth() + 1;
    const excerptText = textFromHtml(post.entry.data.excerpt);
    const bodyText = textFromMarkdown(post.entry.body ?? "");
    const previewHtml = await getPostPreviewHtml(
      post.entry.body,
      post.entry.data.excerpt
    );
    const coverImage = getPostCoverImage(
      post.entry.data.coverImage,
      post.entry.data.slug || post.entry.data.title
    );
    const coverImageAlt = getPostCoverAlt(
      post.entry.data.coverImageAlt,
      post.entry.data.title,
      coverImage
    );
    const tagSlugs = post.entry.data.tags.map(getTaxonomySlug);
    const searchText = [
      post.entry.data.title,
      excerptText,
      bodyText,
      post.entry.data.tags.join(" "),
      categoryLabel,
      post.author?.data.name ?? "",
    ].join(" ");

    return {
      title: post.entry.data.title,
      href: getPostHref(post.entry.data.slug),
      coverImage,
      coverImagePlaceholder: await getProgressiveImagePlaceholder(coverImage),
      coverImageAlt,
      dateISO: post.entry.data.date.toISOString().slice(0, 10),
      dateLabel: formatDate(post.entry.data.date),
      dateHref: getArchiveMonthHref(year, month),
      categoryLabel,
      categoryHref,
      readTime: post.entry.data.readTime,
      authorSlug: post.author?.data.slug ?? "",
      year: String(year),
      month: `${year}-${String(month).padStart(2, "0")}`,
      tagSlugs: tagSlugs.join(" "),
      searchText,
      previewHtml,
    };
  })
);

const resultItemsJson = JSON.stringify(resultItems)
  .replace(/</g, "\\u003c")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
---

<BaseLayout title="Results - Built by Underdogs">
  <main class="main">
    <BackButton href={getPageHref("search")} />
    <PageHeader
      title="Results"
      description="No posts found."
      titleAttributes={{ "data-results-title": "" }}
      descriptionAttributes={{ "data-results-summary": "" }}
    />

    <div class="page search__results-search space-top--xl">
      <SearchForm />
      <p
        class="search__results-empty space-top--lg space-bottom--4xl"
        data-search-empty
        hidden
      >
        No posts matched this search.
      </p>
    </div>

    <script
      is:inline
      type="application/json"
      data-search-results-data
      data-page-size={RESULTS_PER_PAGE}
      set:html={resultItemsJson}
    ></script>

    <hr class="page__divider" data-results-pagination-divider hidden />
    <div class="page__pagination-wrapper" data-results-pagination hidden></div>
  </main>

</BaseLayout>
