---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PaginatedPostList from "../../components/PaginatedPostList.astro";
import {
  getCategories,
  getCategoryHref,
  getResolvedPostsByCategorySlug,
} from "../../lib/content";
import { getHeaderImageAlt } from "../../lib/images";

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((category) => ({
    params: { slug: category.data.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = await getResolvedPostsByCategorySlug(category.data.slug);
---

<BaseLayout title={`${category.data.name} - Built by Underdogs`}>
  <main class="main">
    <PageHeader
      title={category.data.name}
      description={category.data.description}
      image={category.data.headerImage}
      imageAlt={getHeaderImageAlt(category.data.headerImageAlt, category.data.name)}
    />

    <PaginatedPostList
      posts={posts}
      basePath={getCategoryHref(category.data.slug)}
    />
  </main>
</BaseLayout>
