---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import PostList from "../../../components/PostList.astro";
import {
  getPublishedPosts,
  getResolvedPostsByYearMonth,
} from "../../../lib/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const months = new Set<string>();

  for (const post of posts) {
    const year = post.data.date.getFullYear();
    const month = String(post.data.date.getMonth() + 1).padStart(2, "0");
    months.add(`${year}-${month}`);
  }

  return Array.from(months).map((yearMonth) => {
    const [year, month] = yearMonth.split("-");
    return {
      params: { year, month },
      props: { year, month },
    };
  });
}

const { year, month } = Astro.props;
const posts = await getResolvedPostsByYearMonth(year, month);
const date = new Date(Number(year), Number(month) - 1, 1);
const monthLabel = date.toLocaleString("en-US", { month: "long" });
const resultLabel = posts.length === 1 ? "1 post" : `${posts.length} posts`;
---

<BaseLayout title={`Archive: ${monthLabel} ${year} - Built by Underdogs`}>
  <main class="main">
    <PageHeader
      title={`Archive: ${monthLabel} ${year}`}
      description={resultLabel}
    />

    <PostList posts={posts} />
  </main>
</BaseLayout>
