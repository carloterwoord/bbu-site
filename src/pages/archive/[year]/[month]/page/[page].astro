---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import PageHeader from "../../../../../components/PageHeader.astro";
import PaginatedPostList from "../../../../../components/PaginatedPostList.astro";
import {
  getArchiveMonthHref,
  getPublishedPosts,
  getResolvedPostsByYearMonth,
} from "../../../../../lib/content";
import { getPaginatedPageNumbers } from "../../../../../lib/pagination";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const months = new Set<string>();
  const paths = [];

  for (const post of posts) {
    const year = post.data.date.getFullYear();
    const month = String(post.data.date.getMonth() + 1).padStart(2, "0");
    months.add(`${year}-${month}`);
  }

  for (const yearMonth of months) {
    const [year, month] = yearMonth.split("-");
    const monthPosts = await getResolvedPostsByYearMonth(year, month);

    for (const page of getPaginatedPageNumbers(monthPosts.length)) {
      paths.push({
        params: { page: String(page), year, month },
        props: { page, posts: monthPosts, year, month },
      });
    }
  }

  return paths;
}

const { page, posts, year, month } = Astro.props;
const date = new Date(Number(year), Number(month) - 1, 1);
const monthLabel = date.toLocaleString("en-US", { month: "long" });
const resultLabel = posts.length === 1 ? "1 post" : `${posts.length} posts`;
---

<BaseLayout title={`Archive: ${monthLabel} ${year} - Page ${page} - Built by Underdogs`}>
  <main class="main">
    <PageHeader
      title={`Archive: ${monthLabel} ${year}`}
      description={resultLabel}
    />

    <PaginatedPostList
      posts={posts}
      basePath={getArchiveMonthHref(year, month)}
      currentPage={page}
    />
  </main>
</BaseLayout>
