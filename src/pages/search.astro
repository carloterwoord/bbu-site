---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchForm from "../components/SearchForm.astro";
import SearchTagSection from "../components/SearchTagSection.astro";
import {
  getArchiveMonthHref,
  getArchiveYearHref,
  getAuthorHref,
  getAuthors,
  getPageBySlug,
  getPublishedPosts,
  getResolvedTags,
  getTagHref,
} from "../lib/content";

const [posts, authors, resolvedTags, searchPage] = await Promise.all([
  getPublishedPosts(),
  getAuthors(),
  getResolvedTags(),
  getPageBySlug("search"),
]);

const pageTitle = searchPage?.data.title ?? "Search";
const pageExcerpt = searchPage?.data.excerpt?.trim();

const tags = resolvedTags.map((tag) => ({
  label: tag.label,
  href: getTagHref(tag.slug),
}));

const authorSlugsWithPosts = new Set(posts.map((post) => post.data.author));
const authorItems = authors
  .filter((author) => authorSlugsWithPosts.has(author.data.slug))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .map((author) => ({
    label: author.data.name,
    href: getAuthorHref(author.data.slug),
  }));

const postsByYear = posts.reduce<Record<string, Map<number, string>>>((acc, post) => {
  const year = String(post.data.date.getFullYear());
  const monthNumber = post.data.date.getMonth() + 1;
  const monthName = post.data.date.toLocaleString("en-US", { month: "long" });

  if (!acc[year]) acc[year] = new Map();
  if (!acc[year].has(monthNumber)) acc[year].set(monthNumber, monthName);

  return acc;
}, {});

const yearSections = Object.entries(postsByYear)
  .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
  .map(([year, monthMap]) => ({
    year,
    href: getArchiveYearHref(year),
    months: Array.from(monthMap.entries())
      .sort(([monthA], [monthB]) => monthB - monthA)
      .map(([monthNumber, monthName]) => ({
        label: monthName,
        href: getArchiveMonthHref(year, monthNumber),
      })),
  }));
---

<BaseLayout title={`${pageTitle} - Built by Underdogs`}>
  <main class="main">
    <div class="page page__header space-top--3xl">
      <header>
        <h1>{pageTitle === "Search" ? "Search Built by Underdogs" : pageTitle}</h1>
      </header>
      {pageExcerpt && (
        <article>
          <p>{pageExcerpt}</p>
        </article>
      )}
      <hr class="page__header__divider" />
      <div>
        <SearchForm />
      </div>
      <hr class="page__header__divider" />
    </div>

    <div class="page page__content space-top--lg space-bottom--4xl">
      <div>
        <h2>Or, browse through the archives by tag, author, or year</h2>
      </div>

      <SearchTagSection title="Tags" items={tags} />
      <SearchTagSection title="Authors" items={authorItems} />

      {yearSections.map((section) => (
        <SearchTagSection
          title={section.year}
          titleHref={section.href}
          items={section.months}
          ordered={true}
        />
      ))}
    </div>
  </main>
</BaseLayout>
