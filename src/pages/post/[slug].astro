---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackButton from "../../components/BackButton.astro";
import PostArticle from "../../components/PostArticle.astro";
import RelatedPostsFooter from "../../components/RelatedPostsFooter.astro";
import ScrollToTopButton from "../../components/ScrollToTopButton.astro";
import {
  getAuthorHref,
  getCategoryHref,
  getPostHref,
  getResolvedPosts,
} from "../../lib/content";
import { getPostCoverAlt, getPostCoverImage } from "../../lib/images";
import { defaultSocialImageUrl, siteTitle, siteUrl } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getResolvedPosts();
  return posts.map((post) => ({
    params: { slug: post.entry.data.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts = [] } = Astro.props;

const { Content, headings } = await render(post.entry);

const categoryLabel = post.categories[0]?.data.name ?? "Category";
const categoryHref = getCategoryHref(post.categories[0]?.data.slug ?? "category");
const authorName = post.author?.data.name ?? "Built by Underdogs";
const authorBio = post.author?.data.bio ?? "";
const authorAvatar = post.author?.data.avatar ?? "";
const authorAvatarAlt = post.author?.data.avatarAlt ?? "";
const authorHref = post.author ? getAuthorHref(post.author.data.slug) : "";

const postsBySlug = new Map(
  allPosts.map((item) => [item.entry.data.slug, item])
);
const relatedPostSlugs = post.entry.data.relatedPosts ?? [];
const postCategorySlugs = post.entry.data.categories ?? [];
const manualRelated = relatedPostSlugs
  .filter((slug) => slug !== post.entry.data.slug)
  .map((slug) => postsBySlug.get(slug))
  .filter((item): item is typeof allPosts[number] => Boolean(item));
const categorySlugs = new Set(postCategorySlugs);
const automaticRelated = allPosts
  .filter((item) => item.entry.id !== post.entry.id)
  .sort((a, b) => {
    const aSharesCategory = (a.entry.data.categories ?? []).some((slug) =>
      categorySlugs.has(slug)
    );
    const bSharesCategory = (b.entry.data.categories ?? []).some((slug) =>
      categorySlugs.has(slug)
    );

    if (aSharesCategory === bSharesCategory) return 0;
    return aSharesCategory ? -1 : 1;
  })
  .slice(0, 3);
const relatedSource = manualRelated.length > 0 ? manualRelated : automaticRelated;
const related = relatedSource
  .map((item) => ({
    title: item.entry.data.title,
    href: getPostHref(item.entry.data.slug),
  }));
const relatedHeading =
  post.entry.data.relatedPostsHeading?.trim() || "Related posts";
const shouldShowRelatedPosts =
  (post.entry.data.showRelatedPosts ?? true) && related.length > 0;
const seo = post.entry.data.seo ?? {};
const seoKeywords = seo.keywords ?? [];
const geoKeyTakeaways = seo.geoKeyTakeaways ?? [];
const faq = seo.faq ?? [];
const absoluteUrl = (value: string) => {
  if (!value) return "";
  if (/^https?:\/\//i.test(value)) return value;
  return new URL(value.startsWith("/") ? value : `/${value}`, siteUrl).toString();
};
const postUrl = absoluteUrl(getPostHref(post.entry.data.slug));
const seoTitle = seo.title?.trim() || post.entry.data.title;
const metaTitle = `${seoTitle} - ${siteTitle}`;
const metaDescription =
  seo.description?.trim() || post.entry.data.excerpt.trim();
const canonicalUrl = seo.canonicalUrl?.trim() || postUrl;
const socialTitle = seo.openGraphTitle?.trim() || seoTitle;
const socialDescription =
  seo.openGraphDescription?.trim() || metaDescription;
const twitterTitle = seo.twitterTitle?.trim() || socialTitle;
const twitterDescription =
  seo.twitterDescription?.trim() || socialDescription;
const resolvedCoverImage = getPostCoverImage(
  post.entry.data.coverImage,
  post.entry.data.slug || post.entry.data.title
);
const socialImageSource =
  seo.openGraphImage?.trim() ||
  seo.twitterImage?.trim() ||
  resolvedCoverImage;
const socialImage = absoluteUrl(socialImageSource || defaultSocialImageUrl);
const twitterImage = absoluteUrl(
  seo.twitterImage?.trim() || socialImage
);
const openGraphImageAlt = getPostCoverAlt(
  seo.openGraphImageAlt?.trim() ||
    post.entry.data.coverImageAlt ||
    (!socialImageSource ? `${siteTitle} default social sharing image` : ""),
  post.entry.data.title,
  socialImageSource
);
const twitterImageAlt =
  seo.twitterImageAlt?.trim() || openGraphImageAlt;
const robots = [
  seo.noindex ? "noindex" : "index",
  seo.nofollow ? "nofollow" : "follow",
].join(", ");
const keywords = [
  ...seoKeywords,
  ...post.entry.data.tags,
].filter(Boolean);
const geoSummary = seo.geoSummary?.trim() || metaDescription;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": seo.structuredDataType || "BlogPosting",
  headline: seoTitle,
  description: metaDescription,
  abstract: geoSummary,
  url: canonicalUrl,
  datePublished: post.entry.data.date.toISOString(),
  dateModified: post.entry.data.date.toISOString(),
  author: {
    "@type": "Person",
    name: authorName,
    url: authorHref ? absoluteUrl(authorHref) : undefined,
  },
  publisher: {
    "@type": "Organization",
    name: siteTitle,
    url: siteUrl,
  },
  image: socialImage || undefined,
  keywords: keywords.length > 0 ? keywords.join(", ") : undefined,
  about: geoKeyTakeaways.length > 0 ? geoKeyTakeaways : undefined,
  mainEntity:
    faq.length > 0
      ? faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        }))
      : undefined,
};
---

<BaseLayout
  title={metaTitle}
  metadata={{
    title: metaTitle,
    description: metaDescription,
    canonicalUrl,
    image: socialImage,
    openGraphImageAlt,
    openGraphTitle: socialTitle,
    openGraphDescription: socialDescription,
    twitterTitle,
    twitterDescription,
    twitterImage,
    twitterImageAlt,
    type: "article",
    publishedTime: post.entry.data.date.toISOString(),
    modifiedTime: post.entry.data.date.toISOString(),
    author: authorName,
    keywords,
    robots,
    jsonLd,
  }}
>
  <main class="main">
    <BackButton href={categoryHref} />
    <PostArticle
      post={post.entry}
      categoryLabel={categoryLabel}
      categoryHref={categoryHref}
      authorName={authorName}
      authorBio={authorBio}
      authorAvatar={authorAvatar}
      authorAvatarAlt={authorAvatarAlt}
      authorHref={authorHref}
      headings={headings}
    >
      <Content />
    </PostArticle>

    {shouldShowRelatedPosts && (
      <RelatedPostsFooter heading={relatedHeading} items={related}>
        <ScrollToTopButton />
      </RelatedPostsFooter>
    )}
  </main>
</BaseLayout>
