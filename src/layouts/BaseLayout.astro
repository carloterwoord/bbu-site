---
import SiteNav from "../components/SiteNav.astro";
import { withBase } from "../lib/paths";
import {
  defaultSocialImageUrl,
  siteDescription,
  siteTitle,
  siteUrl,
} from "../lib/site";
import { ClientRouter } from "astro:transitions";

type SeoMetadata = {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  openGraphImageAlt?: string;
  openGraphTitle?: string;
  openGraphDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  twitterImageAlt?: string;
  type?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  keywords?: string[];
  robots?: string;
  jsonLd?: unknown;
};

interface Props {
  title?: string;
  showNav?: boolean;
  metadata?: SeoMetadata;
}

const {
  title = "Built by Underdogs - Static Website",
  showNav = true,
  metadata,
} = Astro.props;

const pageTitle = metadata?.title || title;
const description = metadata?.description?.trim() || siteDescription;
const canonicalUrl =
  metadata?.canonicalUrl?.trim() ||
  new URL(Astro.url.pathname, siteUrl).toString();
const image = metadata?.image?.trim() || defaultSocialImageUrl;
const openGraphImageAlt = metadata?.openGraphImageAlt?.trim();
const openGraphTitle = metadata?.openGraphTitle?.trim() || pageTitle;
const openGraphDescription = metadata?.openGraphDescription?.trim() || description;
const twitterTitle = metadata?.twitterTitle?.trim() || openGraphTitle;
const twitterDescription =
  metadata?.twitterDescription?.trim() || openGraphDescription;
const twitterImage = metadata?.twitterImage?.trim() || image;
const twitterImageAlt = metadata?.twitterImageAlt?.trim() || openGraphImageAlt;
const robots = metadata?.robots?.trim();
const keywords = metadata?.keywords?.filter(Boolean).join(", ");
const jsonLd = metadata?.jsonLd
  ? JSON.stringify(metadata.jsonLd).replace(/</g, "\\u003c")
  : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {robots && <meta name="robots" content={robots} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={openGraphTitle} />
    {openGraphDescription && <meta property="og:description" content={openGraphDescription} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content={metadata?.type ?? "website"} />
    {image && <meta property="og:image" content={image} />}
    {openGraphImageAlt && <meta property="og:image:alt" content={openGraphImageAlt} />}
    {metadata?.publishedTime && <meta property="article:published_time" content={metadata.publishedTime} />}
    {metadata?.modifiedTime && <meta property="article:modified_time" content={metadata.modifiedTime} />}
    {metadata?.author && <meta property="article:author" content={metadata.author} />}
    <meta name="twitter:card" content={twitterImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={twitterTitle} />
    {twitterDescription && <meta name="twitter:description" content={twitterDescription} />}
    {twitterImage && <meta name="twitter:image" content={twitterImage} />}
    {twitterImageAlt && <meta name="twitter:image:alt" content={twitterImageAlt} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
    <ClientRouter />
    <script is:inline>
      (() => {
        const themeKey = "bbu-theme";
        const darkTheme = "dark";
        const lightTheme = "light";

        let initialTheme = lightTheme;
        try {
          const storedTheme = window.localStorage.getItem(themeKey);
          if (storedTheme === darkTheme || storedTheme === lightTheme) {
            initialTheme = storedTheme;
          } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            initialTheme = darkTheme;
          }
        } catch (_) {
          if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            initialTheme = darkTheme;
          }
        }

        document.documentElement.setAttribute("data-theme", initialTheme);

        try {
          const stored = window.localStorage.getItem("bbu-desktop-menu-open");
          if (stored === "true" || stored === "false") {
            document.documentElement.setAttribute("data-desktop-menu-open", stored);
          }
        } catch (_) {}
      })();
    </script>
    <link rel="stylesheet" href={withBase("/src/css/style.css")} />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/alpinejs/3.13.3/cdn.min.js" defer></script>
    <script is:inline src={withBase("/src/js/scripts.js")}></script>
  </head>
  <body>
    {showNav && <SiteNav />}
    <slot />
  </body>
</html>
