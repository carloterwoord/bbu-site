---
interface Props {
  dateISO: string;
  dateLabel: string;
  categoryLabel: string;
  categoryHref: string;
  dateHref?: string;
  readTime?: string;
}

const {
  dateISO,
  dateLabel,
  categoryLabel,
  categoryHref,
  dateHref = "",
  readTime = "",
} = Astro.props;
---

<div>
  <time datetime={dateISO}>
    {dateHref ? <a href={dateHref}>{dateLabel}</a> : dateLabel}
  </time>
  <span>•</span>
  <p><a href={categoryHref}>{categoryLabel}</a></p>
  {readTime && (
    <>
      <span>•</span>
      <p>{readTime}</p>
    </>
  )}
</div>
