---
interface Props {
  dateISO: string;
  dateLabel: string;
  categoryLabel: string;
  categoryHref: string;
  dateHref?: string;
  readTime?: string;
}

const {
  dateISO,
  dateLabel,
  categoryLabel,
  categoryHref,
  dateHref = "",
  readTime = "",
} = Astro.props;
---

<div class="article__meta">
  <time class="article__meta-item" datetime={dateISO}>
    {dateHref ? <a href={dateHref}>{dateLabel}</a> : dateLabel}
  </time>
  <span class="article__meta-item">
    <span class="article__meta-separator" aria-hidden="true">•</span>
    <a href={categoryHref}>{categoryLabel}</a>
  </span>
  {readTime && (
    <span class="article__meta-item">
      <span class="article__meta-separator" aria-hidden="true">•</span>
      <span>{readTime}</span>
    </span>
  )}
</div>
