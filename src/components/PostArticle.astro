---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import ArticleMeta from "./ArticleMeta.astro";
import AuthorByline from "./AuthorByline.astro";
import TagList from "./TagList.astro";
import ShareButton from "./ShareButton.astro";
import { formatDate, getArchiveMonthHref, getCategoryHref } from "../lib/content";
import { getAvatarAlt, getPostCoverAlt } from "../lib/images";

interface Props {
  post: CollectionEntry<"posts">;
  categoryLabel: string;
  categoryHref?: string;
  authorName: string;
  authorBio: string;
  authorAvatar: string;
  authorAvatarAlt?: string;
  authorHref?: string;
  headings?: MarkdownHeading[];
}

const {
  post,
  categoryLabel,
  categoryHref = "",
  authorName,
  authorBio,
  authorAvatar,
  authorAvatarAlt = "",
  authorHref = "",
  headings = [],
} = Astro.props;

const resolvedCategoryHref = categoryHref || getCategoryHref(post.data.categories?.[0] ?? "category");
const dateHref = getArchiveMonthHref(
  post.data.date.getFullYear(),
  post.data.date.getMonth() + 1
);
const toc = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
  .map((heading) => ({
    depth: heading.depth,
    href: `#${heading.slug}`,
    text: heading.text,
  }));
const shouldShowTableOfContents =
  (post.data.showTableOfContents ?? true) && toc.length > 0;
const coverImageAlt = getPostCoverAlt(post.data.coverImageAlt, post.data.title);
const resolvedAuthorAvatarAlt = getAvatarAlt(authorAvatarAlt, authorName);
---

{post.data.coverImage && (
  <div class="page__cover-wrapper">
    <div class="page__cover">
      <img src={post.data.coverImage} alt={coverImageAlt} />
    </div>
  </div>
)}

<article class="article space-top--3xl space-bottom--xl">
  <header class="article__headline">
    <ArticleMeta
      dateISO={post.data.date.toISOString().slice(0, 10)}
      dateLabel={formatDate(post.data.date)}
      dateHref={dateHref}
      categoryLabel={categoryLabel}
      categoryHref={resolvedCategoryHref}
      readTime={post.data.readTime}
    />
    <h1>{post.data.title}</h1>
  </header>

  {shouldShowTableOfContents && (
  <nav class="article__table-of-contents" aria-labelledby="post-table-of-contents">
    <header><h2 id="post-table-of-contents">Table of contents</h2></header>
    <ol>
      {toc.map((item) => (
        <li class={`article__table-of-contents__item article__table-of-contents__item--depth-${item.depth}`}>
          <a href={item.href}>{item.text}</a>
        </li>
      ))}
    </ol>
  </nav>
  )}

  <div class="article__content space-top--base">
    <slot />
  </div>

  <footer class="article__footer">
    <AuthorByline
      name={authorName}
      bio={authorBio}
      avatar={authorAvatar}
      avatarAlt={resolvedAuthorAvatarAlt}
      href={authorHref}
    />
    <TagList tags={post.data.tags} />
    <hr class="article__footer__divider" />
    <ShareButton />
  </footer>
</article>
