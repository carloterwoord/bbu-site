---
import ArticleMeta from "./ArticleMeta.astro";
import ArticleCover from "./ArticleCover.astro";
import { getPostCoverAlt } from "../lib/images";

interface Props {
  dateISO: string;
  dateLabel: string;
  dateHref?: string;
  categoryLabel: string;
  categoryHref: string;
  readTime?: string;
  title: string;
  href: string;
  coverImage?: string;
  coverImageAlt?: string;
  previewHtml?: string;
  showDivider?: boolean;
}

const {
  dateISO,
  dateLabel,
  dateHref = "",
  categoryLabel,
  categoryHref,
  readTime = "",
  title,
  href,
  coverImage = "",
  coverImageAlt = "",
  previewHtml = "",
  showDivider = true,
} = Astro.props;

const resolvedCoverImageAlt = getPostCoverAlt(coverImageAlt, title);
---

<article class="article article--preview space-top--3xl space-bottom--3xl">
  <a class="article__preview-link" href={href} aria-label={`Read ${title}`}></a>

  <header class="article__headline">
    <ArticleMeta
      dateISO={dateISO}
      dateLabel={dateLabel}
      dateHref={dateHref}
      categoryLabel={categoryLabel}
      categoryHref={categoryHref}
      readTime={readTime}
    />
    <div class="article__headline__link">
      <h2>{title}</h2>
    </div>
    <ArticleCover src={coverImage} alt={resolvedCoverImageAlt} />
  </header>

  {previewHtml && (
    <div
      class="article__content article__content-preview space-top--base"
      set:html={previewHtml}
    />
  )}

  <div class="article__keep-reading article__keep-reading--preview">
    <a href={href} tabindex="-1" aria-hidden="true">
      Keep reading
    </a>
  </div>
</article>

{showDivider && <hr class="page__divider" />}
