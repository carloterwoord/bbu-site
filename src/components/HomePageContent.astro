---
import type { ResolvedPost } from "../lib/content";
import { withBase } from "../lib/paths";
import PaginatedPostList from "./PaginatedPostList.astro";

interface Props {
  posts: ResolvedPost[];
  currentPage?: number;
}

const { posts, currentPage = 1 } = Astro.props;
---

<PaginatedPostList
  posts={posts}
  basePath={withBase("/")}
  currentPage={currentPage}
/>
