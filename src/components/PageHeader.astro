---
interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  wrapperClass?: string;
}

const {
  title,
  description = "",
  image = "",
  imageAlt = "",
  wrapperClass = "",
} = Astro.props;

const headerClass = [
  "page__header-wrapper",
  image && "page__header-wrapper--image",
  wrapperClass,
].filter(Boolean).join(" ");
---

<div class={headerClass}>
  {image && (
    <img class="page__header-image" src={image} alt={imageAlt} loading="lazy" />
  )}
  <div class="page__header">
    <header>
      <h1>{title}</h1>
    </header>
    {description && (
      <article>
        <p>{description}</p>
      </article>
    )}
  </div>
</div>
