---
import ProgressiveImage from "./ProgressiveImage.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  wrapperClass?: string;
  titleAttributes?: Record<string, string>;
  descriptionAttributes?: Record<string, string>;
}

const {
  title,
  description = "",
  image = "",
  imageAlt = "",
  wrapperClass = "",
  titleAttributes = {},
  descriptionAttributes = {},
} = Astro.props;

const headerClass = [
  "page__header-wrapper",
  image && "page__header-wrapper--image",
  wrapperClass,
].filter(Boolean).join(" ");
---

<div class={headerClass}>
  {image && (
    <ProgressiveImage className="page__header-image" src={image} alt={imageAlt} />
  )}
  <div class="page__header">
    <header>
      <h1 {...titleAttributes}>{title}</h1>
    </header>
    {description && (
      <article>
        <p {...descriptionAttributes}>{description}</p>
      </article>
    )}
  </div>
</div>
