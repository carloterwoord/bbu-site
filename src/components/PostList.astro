---
import type { ResolvedPost } from "../lib/content";
import ArticlePreviewCard from "./ArticlePreviewCard.astro";
import {
  formatDate,
  getArchiveMonthHref,
  getCategoryHref,
  getPostHref,
} from "../lib/content";
import { getPostPreviewHtml } from "../lib/preview";

interface Props {
  posts: ResolvedPost[];
}

const { posts } = Astro.props;

const previewPosts = await Promise.all(posts.map(async (post, index) => {
  const firstCategory = post.categories[0];
  const categoryLabel = firstCategory?.data.name ?? "Category";
  const categoryHref = getCategoryHref(firstCategory?.data.slug ?? "category");
  const year = post.entry.data.date.getFullYear();
  const month = post.entry.data.date.getMonth() + 1;
  const previewHtml = await getPostPreviewHtml(
    post.entry.body,
    post.entry.data.excerpt
  );

  return {
    dateISO: post.entry.data.date.toISOString().slice(0, 10),
    dateLabel: formatDate(post.entry.data.date),
    dateHref: getArchiveMonthHref(year, month),
    categoryLabel,
    categoryHref,
    readTime: post.entry.data.readTime,
    title: post.entry.data.title,
    href: getPostHref(post.entry.data.slug),
    coverImageSeed: post.entry.data.slug,
    coverImage: post.entry.data.coverImage,
    coverImageAlt: post.entry.data.coverImageAlt,
    previewHtml,
    showDivider: index < posts.length - 1,
  };
}));
---

{previewPosts.map((post) => (
  <ArticlePreviewCard
    dateISO={post.dateISO}
    dateLabel={post.dateLabel}
    dateHref={post.dateHref}
    categoryLabel={post.categoryLabel}
    categoryHref={post.categoryHref}
    readTime={post.readTime}
    title={post.title}
    href={post.href}
    coverImageSeed={post.coverImageSeed}
    coverImage={post.coverImage}
    coverImageAlt={post.coverImageAlt}
    previewHtml={post.previewHtml}
    showDivider={post.showDivider}
  />
))}
