---
import { getResultsHref } from "../lib/content";

interface Props {
  value?: string;
}

const { value = "" } = Astro.props;
---

<form method="get" class="search-form" action={getResultsHref()}>
  <label class="screen-reader-text" for="siteSearch">Search for:</label>
  <input
    id="siteSearch"
    name="q"
    class="search-field"
    placeholder="Search Built by Underdogs..."
    type="text"
    value={value}
    required
  />
  <input type="submit" class="search-submit" value="Search" />
</form>
