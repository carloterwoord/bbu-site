---
interface Props {
  name: string;
  bio: string;
  avatar: string;
  href?: string;
}

const { name, bio, avatar, href = "" } = Astro.props;
---

<aside class="author author__border">
  <div class="author__header">
    <figure class="author__avatar">
      <img src={avatar} alt={`Avatar of ${name}`} />
    </figure>
    <div>
      <span>About the Author</span>
      <h2>
        {href ? <a href={href} class="author__link">{name}</a> : name}
      </h2>
      <p>{bio}</p>
    </div>
  </div>
</aside>
