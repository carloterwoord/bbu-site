---
interface Props {
  currentPage?: number;
  totalPages?: number;
}

const { currentPage = 1, totalPages = 6 } = Astro.props;

const pages = Array.from({ length: totalPages }, (_, index) => index + 1);
---

<div class="page__pagination-wrapper">
  <div class="page__pagination">
    <hr class="page__divider" />
    <nav class="pagination">
      <a href="#" class="pagination__button pagination__prev"
        >← <span class="pagination__button__text">Previous</span></a
      >

      <ul class="pagination__list">
        {pages.map((page) => (
          <li>
            <a
              href="#"
              class={`pagination__link ${
                page === currentPage ? "pagination__link--active" : ""
              }`.trim()}
            >
              {page}
            </a>
          </li>
        ))}
      </ul>

      <a href="#" class="pagination__button pagination__next"
        ><span class="pagination__button__text">Next</span> →</a
      >
    </nav>
  </div>
</div>
