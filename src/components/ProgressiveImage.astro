---
import { getProgressiveImagePlaceholder } from "../lib/images";

interface Props {
  src: string;
  alt: string;
  className?: string;
  loading?: "eager" | "lazy";
}

const {
  src,
  alt,
  className = "",
  loading = "lazy",
} = Astro.props;

const placeholderSrc = await getProgressiveImagePlaceholder(src);
const hasPlaceholder = Boolean(placeholderSrc && placeholderSrc !== src);
const imageClass = [
  "progressive-image",
  !hasPlaceholder && "progressive-image--loaded",
  className,
].filter(Boolean).join(" ");
---

{src && (
  <img
    class={imageClass}
    src={hasPlaceholder ? placeholderSrc : src}
    data-progressive-image
    data-progressive-src={src}
    data-progressive-placeholder-src={hasPlaceholder ? placeholderSrc : undefined}
    alt={alt}
    loading={loading}
    decoding="async"
  />
)}
