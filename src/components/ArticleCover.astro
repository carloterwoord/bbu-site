---
import ProgressiveImage from "./ProgressiveImage.astro";

interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

{src && (
  <div class="article__cover-wrapper">
    <div class="article__cover">
      <ProgressiveImage src={src} alt={alt} />
    </div>
  </div>
)}
